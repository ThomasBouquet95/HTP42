# Airtable
AIRTABLE_PAT=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Auth — 32+ random bytes, e.g. `openssl rand -base64 48`
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL used in magic-link emails (no trailing slash)
APP_URL=http://localhost:3000

# SMTP for magic-link emails (required in production).
# When SMTP_HOST is empty, magic links are logged to the server console
# instead of emailed — useful for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HTP42 Timesheets <no-reply@htp42.example>"
